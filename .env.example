# ===== AI Slide Bot — muhit o'zgaruvchilari namunasi =====
# Bu faylni .env deb nomlang yoki Render dashboard'da Environment Variables ga kiriting.

# Telegram bot (BotFather dan oling)
BOT_TOKEN=8863758833:AAGOo38f5EyymLztgvL9dw94xB4oZtfT7bE
BOT_USERNAME=@Talaba_AI_SlideBot
ADMIN_ID=6377032074

# AI API — Renderda LOKAL (127.0.0.1) ISHLAMAYDI! Cloud API ishlating.
# Masalan OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-sizning-kalitingiz
AI_MODEL=openai/gpt-4o-mini
AI_TIMEOUT=120

# Proxy (kerak bo'lsa, aks holda bo'sh qoldiring)
PROXY_URL=

# Web admin panel
WEB_ADMIN_PASSWORD=admin123

# To'lov va referal
FREE_MODE=1
DEFAULT_REFERRAL_BONUS=500
MIN_TOPUP=1000

# Kanal obunasi (kerak bo'lsa)
REQUIRE_CHANNEL_SUBSCRIPTION=0
CHANNEL_USERNAME=@channel

# Renderda doimiy ma'lumotlar papkasi (Disk ulagan bo'lsangiz)
DATA_DIR=/opt/render/project/src/data
